# Copy to .env and fill in only what you use. Never commit .env.

# Telegram bot (docs/TELEGRAM_SETUP.md): token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_VOICE_REPLY=1

# WhatsApp Cloud API (docs/WHATSAPP_SETUP.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VOICE_REPLY=1
# 1 hides the WhatsApp QR (e.g. while the number awaits Meta business verification)
WHATSAPP_PAUSED=

# Public https address for links in chat replies (found automatically from a running cloudflared quick tunnel)
PUBLIC_URL=
